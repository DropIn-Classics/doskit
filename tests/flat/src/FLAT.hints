; The kit's test of a pMAX image (tests/selftest.py): tests/flat/FLAT.ASM,
; written as a pMAX image into the build folder by the selftest.
pmax       build/files/FLAT.386
segment    CODE 0 CODE
segment    MORE 1 DATA

words      CODE:0006 3 CODE
dptr       CODE:004B CODE
ptr        CODE:0057 CODE
rwords     CODE:00D6 4             ; the switch's offsets from the table
dptr       CODE:00C5 CODE          ; MOVSX EDI,SWTAB[EDI*2]
dptr       CODE:00CD CODE          ; LEA EDI,[EDI+SWTAB]
words      CODE:00F0 2 CODE stride=8   ; the handlers of the records at CODE:00EC
rwords     CODE:010A 2 stride=4 from=010E  ; offsets in records, from the second

name       CODE:0000 SAVED_DS
name       CODE:0002 COUNT
name       CODE:0006 HANDLERS
name       CODE:0012 FAR_SUB
name       CODE:0018 TEXT
code       CODE:002E START
name       CODE:0057 NEXT
name       CODE:008E SHOW
name       MORE:0004 OTHER
comment    CODE:0006 near pointers, called in turn
raw        CODE:0086               ; FNINIT, no x87 in tasm.py
stop       CODE:00B5               ; INT 93h AX=0, the test's exit; data follows
